<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/library_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/launcher_status_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_phone_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/launcher_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:text="@string/launcher_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/library_count"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="11sp"
                tools:text="12 GAMES" />

            <TextView
                android:id="@+id/launcher_ready"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/launcher_clock"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center_vertical|end"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                tools:text="14:35" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/library_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/launcher_rail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_phone_panel"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/rail_library"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_phone_rail_item"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/library_title"
                    android:textColor="@color/accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rail_recent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/launcher_recent"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/rail_favorites"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/launcher_favorites"
                    android:textColor="@color/text_primary"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/rail_add_game"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/launcher_add_game"
                    android:textColor="@color/text_primary"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/rail_folders"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/launcher_folders"
                    android:textColor="@color/text_primary"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/rail_settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/action_settings"
                    android:textColor="@color/text_secondary"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/library_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_phone_panel"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/library_top_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/library_title"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:gravity="center_vertical"
                            android:text="@string/library_title"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/library_sort"
                            android:layout_width="92dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_phone_mode"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:text="@string/pref_app_sort_title"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/library_search"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_phone_input"
                        android:fontFamily="monospace"
                        android:hint="@string/search"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/library_mode_row"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/view_mode_gallery"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_phone_mode"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="@string/view_mode_gallery"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/view_mode_list"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_phone_mode"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="@string/view_mode_list"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/view_mode_grid"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_phone_mode"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="@string/view_mode_grid"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/library_filter_hint"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/apps_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingVertical="4dp"
                        tools:listitem="@layout/list_row_jar" />

                    <TextView
                        android:id="@android:id/empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="monospace"
                        android:text="@string/no_data_for_display"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_panel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:id="@+id/detail_section_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/detail_cover" android:layout_width="1dp" android:layout_height="1dp" />
                <TextView android:id="@+id/detail_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/detail_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/detail_play" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/detail_settings" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/detail_favorite" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/detail_compatibility" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/launcher_softbar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_add_white" />
</FrameLayout>
