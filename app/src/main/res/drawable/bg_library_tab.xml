<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/abyss_focus_surface" />
            <stroke android:width="2dp" android:color="?attr/abyss_phone_cyan" />
            <corners android:radius="?attr/abyss_cornerRadius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="?attr/abyss_btn_bg_pressed" /></shape>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><shape><solid android:color="?attr/abyss_phone_panel_alt" /></shape></item>
            <item android:gravity="bottom" android:height="2dp">
                <shape><solid android:color="?attr/abyss_accent" /></shape>
            </item>
        </layer-list>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /></shape></item>
</selector>
