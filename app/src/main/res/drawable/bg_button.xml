<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/abyss_btn_bg_pressed"/>
            <stroke android:width="?attr/abyss_controlStroke" android:color="?attr/abyss_accent" />
            <corners android:radius="?attr/abyss_cornerRadius"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/abyss_btn_bg_normal"/>
            <stroke android:width="?attr/abyss_controlStroke" android:color="?attr/abyss_phone_line" />
            <corners android:radius="?attr/abyss_cornerRadius"/>
        </shape>
    </item>
</selector>
