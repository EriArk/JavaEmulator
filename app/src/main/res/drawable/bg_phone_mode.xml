<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/abyss_selected_surface" />
            <stroke android:width="2dp" android:color="?attr/abyss_accent" />
            <corners android:radius="?attr/abyss_cornerRadius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/abyss_focus_surface" />
            <stroke android:width="2dp" android:color="?attr/abyss_phone_cyan" />
            <corners android:radius="?attr/abyss_cornerRadius" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/abyss_phone_panel" />
            <stroke android:width="?attr/abyss_controlStroke" android:color="?attr/abyss_phone_line" />
            <corners android:radius="?attr/abyss_cornerRadius" />
        </shape>
    </item>
</selector>
