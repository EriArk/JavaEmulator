<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/selected_surface" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/focus_surface" />
            <stroke android:width="2dp" android:color="@color/phone_cyan" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/phone_panel" />
            <stroke android:width="1dp" android:color="@color/phone_line" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
