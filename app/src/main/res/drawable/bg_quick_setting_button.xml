<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#202014" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/btn_bg_pressed" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/phone_panel_alt" />
            <stroke android:width="1dp" android:color="@color/phone_line" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
