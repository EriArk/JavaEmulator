<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/midletFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="javax.microedition.shell.MicroActivity">

    <LinearLayout
        android:id="@+id/virtual_display"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:descendantFocusability="blocksDescendants"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            tools:title="MIDlet Title" />

        <FrameLayout
            android:id="@+id/displayable_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- MUST be transparent and math root container -->
    <javax.microedition.lcdui.overlay.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/quick_settings_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/quick_settings_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:baselineAligned="false"
            android:background="@drawable/bg_quick_map_panel"
            android:orientation="horizontal">

            <Button
                android:id="@+id/quick_settings_quality"
                android:layout_width="92dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_quick_setting_button"
                android:drawableTop="@drawable/ic_quick_quality"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/quick_settings_view"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/quick_settings_screen"
                android:layout_width="92dp"
                android:layout_height="72dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_quick_setting_button"
                android:drawableTop="@drawable/ic_quick_size"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/quick_settings_screen"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/quick_settings_controls"
                android:layout_width="92dp"
                android:layout_height="72dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_quick_setting_button"
                android:drawableTop="@drawable/ic_quick_orientation"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/quick_settings_controls"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/quick_screen_options"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_quick_map_panel" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/quick_screen_auto" style="@style/QuickOptionButton" android:text="Auto" />
                <Button android:id="@+id/quick_screen_176" style="@style/QuickOptionButton" android:text="176x220" />
                <Button android:id="@+id/quick_screen_240" style="@style/QuickOptionButton" android:text="240x320" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/quick_screen_land" style="@style/QuickOptionButton" android:text="320x240" />
                <Button android:id="@+id/quick_screen_480" style="@style/QuickOptionButton" android:text="480x800" />
                <Button android:id="@+id/quick_screen_swap" style="@style/QuickOptionButton" android:text="Swap W/H" />
            </LinearLayout>
            <Button android:id="@+id/quick_screen_rotate" style="@style/QuickOptionButton"
                android:layout_width="264dp" android:drawableStart="@drawable/ic_quick_orientation"
                android:paddingHorizontal="12dp" android:text="@string/quick_rotate_image" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <ImageButton
        android:id="@+id/game_display_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_quick_setting_button"
        android:src="@drawable/ic_quick_size"
        android:tint="@color/text_primary"
        android:padding="12dp"
        android:contentDescription="Quick display settings"
        android:tooltipText="Quick display settings"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/game_menu_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_quick_setting_button"
        android:src="@drawable/ic_baseline_tune_24"
        android:tint="@color/text_primary"
        android:padding="12dp"
        android:contentDescription="Game menu"
        android:tooltipText="Game menu"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/quick_map_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
