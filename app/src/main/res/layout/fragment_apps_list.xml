<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout
        android:id="@+id/library_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/library_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/launcher_title"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/launcher_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/library_count"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="12dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/library_category"
                android:layout_width="112dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_library_tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="All games"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:drawableTint="@color/text_secondary"
                android:paddingHorizontal="8dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/library_search_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_library_tab"
                android:src="@android:drawable/ic_menu_search"
                android:tint="@color/text_primary"
                android:padding="12dp"
                android:contentDescription="@string/search"
                android:tooltipText="@string/search"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/library_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_library_tab"
                android:src="@drawable/ic_list"
                android:tint="@color/text_primary"
                android:padding="12dp"
                android:contentDescription="Library menu"
                android:tooltipText="Library menu"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/rail_add_game"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_phone_mode"
                android:src="@drawable/ic_add_white"
                android:tint="@color/text_primary"
                android:padding="12dp"
                android:contentDescription="@string/launcher_add_game"
                android:tooltipText="@string/launcher_add_game" />
            <ImageButton
                android:id="@+id/rail_folders"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_phone_mode"
                android:src="@drawable/ic_setting_folder"
                android:tint="@color/text_primary"
                android:padding="12dp"
                android:contentDescription="@string/launcher_folders"
                android:tooltipText="@string/launcher_folders" />
            <ImageButton
                android:id="@+id/rail_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_phone_mode"
                android:src="@drawable/ic_baseline_tune_24"
                android:tint="@color/text_primary"
                android:padding="12dp"
                android:contentDescription="@string/action_settings"
                android:tooltipText="@string/action_settings" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/library_category_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/rail_library"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_phone_mode"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="All games"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/rail_recent"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_phone_mode"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/launcher_recent"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/rail_favorites"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_phone_mode"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/launcher_favorites"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/library_search_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/library_search"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:background="@drawable/bg_phone_input"
                android:hint="@string/search"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />
            <ImageButton
                android:id="@+id/library_sort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_phone_mode"
                android:src="@drawable/ic_setting_sort"
                android:tint="@color/text_primary"
                android:padding="12dp"
                android:contentDescription="@string/pref_app_sort_title"
                android:tooltipText="@string/pref_app_sort_title" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/library_mode_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/view_mode_gallery"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_phone_mode"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/view_mode_gallery"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/view_mode_list"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_phone_mode"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/view_mode_list"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/view_mode_grid"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_phone_mode"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/view_mode_grid"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/library_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/launcher_clock"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/apps_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />
                <TextView
                    android:id="@android:id/empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/no_data_for_display"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </FrameLayout>
            <LinearLayout
                android:id="@+id/detail_panel"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/detail_cover"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_art_fallback"
                    android:scaleType="centerCrop" />
                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/detail_meta"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/detail_play"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_phone_mode"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/play"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/detail_settings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_phone_mode"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/action_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/detail_favorite"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_phone_mode"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/add_favorite"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/launcher_softbar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="@drawable/bg_phone_softbar"
            android:text="A  Play     X  Options     Y  Favorite     L/R  View"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_add_white" />
</FrameLayout>
