<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/library_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/launcher_status_bar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_phone_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/launcher_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:text="@string/launcher_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/library_count"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="13sp"
                tools:text="12 GAMES" />

            <TextView
                android:id="@+id/launcher_ready"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/launcher_ready"
                android:textColor="@color/phone_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launcher_clock"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center_vertical|end"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="14:35" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/library_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/launcher_rail"
                android:layout_width="132dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_phone_panel"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/rail_library"
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:background="@drawable/bg_phone_rail_item"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="@string/library_title"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rail_recent"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/launcher_recent"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rail_favorites"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/launcher_favorites"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rail_add_game"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/launcher_add_game"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rail_folders"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/launcher_folders"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/rail_settings"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_phone_rail_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/action_settings"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/library_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_phone_panel"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/library_top_row"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/library_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="center_vertical"
                        android:text="@string/library_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/library_search"
                        android:layout_width="210dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_phone_input"
                        android:fontFamily="monospace"
                        android:hint="@string/search"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/library_sort"
                        android:layout_width="96dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_phone_mode"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="@string/pref_app_sort_title"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/library_mode_row"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/view_mode_gallery"
                        android:layout_width="104dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_phone_mode"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="@string/view_mode_gallery"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/view_mode_list"
                        android:layout_width="104dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_phone_mode"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="@string/view_mode_list"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/view_mode_grid"
                        android:layout_width="104dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_phone_mode"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="@string/view_mode_grid"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/library_filter_hint"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="center_vertical|end"
                        android:text="@string/launcher_search_hint"
                        android:textColor="@color/phone_cyan"
                        android:textSize="11sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/apps_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        tools:listitem="@layout/list_row_jar" />

                    <TextView
                        android:id="@android:id/empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="monospace"
                        android:text="@string/no_data_for_display"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_panel"
                android:layout_width="330dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_phone_panel"
                android:orientation="vertical"
                android:padding="12dp"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/detail_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:text="@string/launcher_detail_title"
                    android:textColor="@color/phone_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/detail_cover"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_art_fallback"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/bg_art_fallback" />

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:textColor="@color/accent"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Stalker" />

                <TextView
                    android:id="@+id/detail_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Vendor  1.0" />

                <TextView
                    android:id="@+id/detail_play"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_phone_mode"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/play"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_settings"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_mode"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/action_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/detail_favorite"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_mode"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="@string/add_favorite"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/detail_compatibility"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_input"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:text="@string/launcher_compatibility"
                    android:textColor="@color/phone_green"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/launcher_softbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_phone_softbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:text="@string/launcher_soft_select"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/launcher_soft_back"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/launcher_soft_favorite"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center_vertical|end"
                android:text="@string/launcher_soft_mode"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_add_white" />
</FrameLayout>
