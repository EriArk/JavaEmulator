<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/library_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/abyss_background">
    <LinearLayout android:id="@+id/library_header"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="12dp" android:gravity="center_vertical">
        <TextView android:id="@+id/launcher_title"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:text="AbyssME" android:textSize="18sp"
            android:textStyle="bold" android:singleLine="true" android:textColor="?attr/abyss_text_primary" />
        <ImageButton android:id="@+id/library_search_toggle"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:src="@drawable/ic_library_search"
            app:tint="?attr/abyss_text_primary" android:padding="12dp"
            android:contentDescription="Search" android:tooltipText="Search" />
        <ImageButton android:id="@+id/rail_add_game"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:src="@drawable/ic_library_plus"
            app:tint="?attr/abyss_text_primary" android:padding="12dp"
            android:contentDescription="Add game" android:tooltipText="Add game" />
        <ImageButton android:id="@+id/library_social"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:src="@drawable/ic_library_messages_square"
            app:tint="?attr/abyss_text_primary" android:padding="12dp"
            android:contentDescription="Social" android:tooltipText="Social" />
        <ImageButton android:id="@+id/library_menu"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:src="@drawable/ic_library_ellipsis_vertical"
            app:tint="?attr/abyss_text_primary" android:padding="12dp"
            android:contentDescription="Library menu" android:tooltipText="Library menu" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/library_platform_scroll"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/library_platform_tabs"
            android:layout_width="wrap_content" android:layout_height="match_parent" android:paddingHorizontal="8dp">
            <TextView android:id="@+id/platform_java"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:minWidth="80dp" android:paddingHorizontal="10dp"
                android:background="@drawable/bg_library_tab" android:clickable="true" android:focusable="true"
                android:gravity="center" android:singleLine="true" android:text="Java ME"
                android:textSize="14sp" android:textColor="?attr/abyss_text_primary" />
            <TextView android:id="@+id/platform_mophun"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:minWidth="80dp" android:paddingHorizontal="10dp"
                android:background="@drawable/bg_library_tab" android:clickable="true" android:focusable="true"
                android:gravity="center" android:singleLine="true" android:text="Mophun"
                android:textSize="14sp" android:textColor="?attr/abyss_text_primary" />
            <TextView android:id="@+id/platform_symbian"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:minWidth="80dp" android:paddingHorizontal="10dp"
                android:background="@drawable/bg_library_tab" android:clickable="true" android:focusable="true"
                android:gravity="center" android:singleLine="true" android:text="Symbian"
                android:textSize="14sp" android:textColor="?attr/abyss_text_primary" />
            <TextView android:id="@+id/platform_ngage"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:minWidth="80dp" android:paddingHorizontal="10dp"
                android:background="@drawable/bg_library_tab" android:clickable="true" android:focusable="true"
                android:gravity="center" android:singleLine="true" android:text="N-Gage"
                android:textSize="14sp" android:textColor="?attr/abyss_text_primary" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout android:id="@+id/library_search_row"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="12dp" android:visibility="gone">
        <EditText android:id="@+id/library_search"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:background="@drawable/bg_phone_input" android:hint="@string/search"
            android:imeOptions="actionSearch" android:inputType="text" android:singleLine="true"
            android:textColor="?attr/abyss_text_primary" android:textColorHint="?attr/abyss_text_secondary"
            android:textSize="14sp" />
        <ImageButton android:id="@+id/library_search_close"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="?attr/abyss_text_primary" android:padding="12dp"
            android:contentDescription="Close search" android:tooltipText="Close search" />
    </LinearLayout>
    <LinearLayout android:id="@+id/library_tools"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="12dp" android:gravity="center_vertical">
        <TextView android:id="@+id/library_category"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:clickable="true" android:focusable="true"
            android:gravity="center_vertical" android:paddingHorizontal="8dp"
            android:singleLine="true" android:ellipsize="end" android:text="All games"
            android:drawableEnd="@android:drawable/arrow_down_float" android:drawableTint="?attr/abyss_text_secondary"
            android:textSize="13sp" android:textColor="?attr/abyss_text_secondary" />
        <TextView android:id="@+id/library_generation"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:clickable="true" android:focusable="true"
            android:minWidth="48dp" android:paddingHorizontal="8dp" android:gravity="center"
            android:text="All" android:textSize="13sp" android:textColor="?attr/abyss_text_secondary"
            android:visibility="gone" />
        <TextView android:id="@+id/library_count"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center" android:paddingHorizontal="12dp"
            android:textSize="12sp" android:textColor="?attr/abyss_text_secondary" />
        <LinearLayout android:id="@+id/library_mode_row"
            android:layout_width="wrap_content" android:layout_height="48dp">
        <ImageButton android:id="@+id/view_mode_gallery"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:src="@drawable/ic_library_gallery_horizontal_end"
            app:tint="?attr/abyss_text_primary" android:padding="12dp"
            android:contentDescription="Gallery" android:tooltipText="Gallery" />
        <ImageButton android:id="@+id/view_mode_list"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:src="@drawable/ic_library_list"
            app:tint="?attr/abyss_text_primary" android:padding="12dp"
            android:contentDescription="List" android:tooltipText="List" />
        <ImageButton android:id="@+id/view_mode_grid"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_library_tab" android:src="@drawable/ic_library_layout_grid"
            app:tint="?attr/abyss_text_primary" android:padding="12dp"
            android:contentDescription="Grid" android:tooltipText="Grid" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingHorizontal="8dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/apps_recycler"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="8dp" />
        <LinearLayout android:id="@+id/library_empty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:padding="16dp" android:gravity="center" android:orientation="vertical"
            android:visibility="gone">
            <TextView android:id="@android:id/empty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textSize="16sp" android:textColor="?attr/abyss_text_secondary" />
            <Button android:id="@+id/empty_add_game"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="12dp"
                android:text="Add game" android:textAllCaps="false"
                android:drawableStart="@drawable/ic_add_white" android:drawableTint="?attr/abyss_accent"
                android:drawablePadding="8dp" android:paddingHorizontal="16dp"
                android:background="@drawable/bg_library_tab" android:textColor="?attr/abyss_text_primary" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
