<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/installer_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_quick_map_panel"
    android:orientation="vertical"
    android:padding="18dp"
    tools:context="ru.woesss.j2me.installer.InstallerDialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/installer_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_phone_input"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/installer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:text="MIDlet installer"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/installation_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="@string/loading_info"
                android:textColor="@color/phone_cyan"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/installation_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/installer_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:minHeight="130dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        tools:text="Name: Example\nVendor: Example\nVersion: 1.0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_close"
            android:layout_width="132dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_quick_setting_button"
            android:fontFamily="monospace"
            android:text="@string/close"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/button_install"
            android:layout_width="132dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_quick_setting_button"
            android:fontFamily="monospace"
            android:text="@string/install"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_start"
            android:layout_width="132dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_quick_setting_button"
            android:fontFamily="monospace"
            android:text="@string/START_CMD"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
