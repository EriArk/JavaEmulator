<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.DayNight">
        <item name="abyss_cornerRadius">4dp</item>
        <item name="abyss_controlStroke">1dp</item>
        <item name="abyss_card">@drawable/bg_game_card</item>
        <item name="abyss_primary">@color/primary</item>
        <item name="abyss_primary_dark">@color/primary_dark</item>
        <item name="abyss_accent">@color/accent</item>
        <item name="abyss_background">@color/background</item>
        <item name="abyss_text_primary">@color/text_primary</item>
        <item name="abyss_text_secondary">@color/text_secondary</item>
        <item name="abyss_btn_bg_normal">@color/btn_bg_normal</item>
        <item name="abyss_btn_bg_pressed">@color/btn_bg_pressed</item>
        <item name="abyss_config_card">@color/config_card</item>
        <item name="abyss_config_card_stroke">@color/config_card_stroke</item>
        <item name="abyss_phone_panel">@color/phone_panel</item>
        <item name="abyss_phone_panel_alt">@color/phone_panel_alt</item>
        <item name="abyss_phone_cyan">@color/phone_cyan</item>
        <item name="abyss_phone_green">@color/phone_green</item>
        <item name="abyss_phone_line">@color/phone_line</item>
        <item name="abyss_focus_surface">@color/focus_surface</item>
        <item name="abyss_selected_surface">@color/selected_surface</item>
        <item name="abyss_input_surface">@color/input_surface</item>
        <item name="abyss_menu_surface">@color/menu_surface</item>
        <item name="abyss_on_accent">@color/on_accent</item>
        <item name="abyss_mapper_lcd">@color/mapper_lcd</item>
        <item name="abyss_mapper_lcd_text">@color/mapper_lcd_text</item>
        <item name="abyss_mapper_lcd_line">@color/mapper_lcd_line</item>
        <item name="abyss_control_a">@color/control_a</item>
        <item name="abyss_control_b">@color/control_b</item>
        <item name="abyss_control_x">@color/control_x</item>
        <item name="abyss_control_y">@color/control_y</item>
        <item name="abyss_touch_surface">@color/touch_surface</item>
        <item name="abyss_touch_button">@color/touch_button</item>
        <item name="abyss_touch_line">@color/touch_line</item>
        <item name="abyss_touch_key_highlight">@color/touch_key_highlight</item>
        <item name="abyss_touch_key_shadow">@color/touch_key_shadow</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="buttonStyle">@style/ButtonStyle</item>
        <item name="bg_config_card">@drawable/bg_config_card</item>
        <item name="textColorPrimary">@color/text_primary</item>
        <item name="textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="alertDialogTheme">@style/FilePickerAlertDialogTheme</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="SettingsTheme" parent="AppTheme">
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="actionOverflowMenuStyle">@style/Widget.AppTheme.OverflowMenu</item>
        <item name="textAppearancePopupMenuHeader">@style/PopupMenuTextAppearanceHeader</item>
        <item name="textAppearanceSmallPopupMenu">@style/PopupMenuTextAppearanceSmall</item>
        <item name="textAppearanceLargePopupMenu">@style/PopupMenuTextAppearanceLarge</item>
    </style>

    <style name="Widget.AppTheme.OverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/background</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="PopupMenuTextAppearanceHeader" parent="TextAppearance.AppCompat.Widget.PopupMenu.Header">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PopupMenuTextAppearanceSmall" parent="TextAppearance.AppCompat.Widget.PopupMenu.Small">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PopupMenuTextAppearanceLarge" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="FilePickerTheme" parent="Theme.AppCompat.DayNight.DialogWhenLarge">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/file_picker_accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="nnf_toolbarTheme">@style/ThemeOverlay.AppCompat.ActionBar</item>
        <item name="alertDialogTheme">@style/FilePickerAlertDialogTheme</item>
        <item name="nnf_separator_color">@color/nnf_separator_color</item>
        <item name="nnf_save_icon_color">?attr/colorAccent</item>
        <item name="nnf_dir_icon_color">?attr/colorAccent</item>

        <!-- These are important. Handled by toolbar. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="FilePickerAlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/file_picker_accent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="ConfigTitleTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SwitchStyle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?textColorSecondary</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="EditTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
    </style>

    <style name="ButtonStyle" parent="Widget.AppCompat.Button.Colored">
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:elevation" tools:targetApi="lollipop">1dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="QuickOptionButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_quick_setting_button</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ImageButtonStyle" parent="Widget.AppCompat.ImageButton">
        <item name="android:minHeight">38dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:tint">?colorAccent</item>
    </style>

    <style name="TextViewVendor" parent="Widget.AppCompat.TextView" >
    </style>

</resources>
