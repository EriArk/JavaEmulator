  <string name="native_remove_component_body">%1$s\nInstalled games and saves stay untouched.</string>
  <string name="native_backup_preview">%1$s\n\nIncludes system files, installed games, saves and game settings. Keep this archive private.\n\nThe game must be closed. This is not an in-game save state.</string>
  <string name="native_restore_preview_v1">%1$s\n\n%2$d MB unpacked. Includes phone system files, installed games, saves and game settings.\n\nRestores a separate phone. Existing phones, games and saves are not replaced.\n\nOnly restore backups you trust.</string>
  <string name="native_restore_preview_v2">%1$s\n\n%2$d MB unpacked. Includes phone system files, installed games, saves and game settings. Custom covers and icons are included when available.\n\nRestores a separate phone. Existing phones, games and saves are not replaced.\n\nOnly restore backups you trust.</string>
  <string name="native_restore_preview_v3">%1$s\n\n%2$d MB unpacked. Includes phone system files, installed games, saves and game settings. Custom covers and icons are included when available. Custom game titles are included too.\n\nRestores a separate phone. Existing phones, games and saves are not replaced.\n\nOnly restore backups you trust.</string>
  <string name="native_removal_preview">Phone: %1$s\nPackage: %2$s %3$s\n\nApplications to remove:\n%4$s\n\nRemoves the installed package and its private data. Game saves may be deleted; some legacy saves may remain.\n\nThere is no automatic undo. Back up this phone first if you want to keep its progress.</string>
