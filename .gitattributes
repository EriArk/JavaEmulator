# Preserve downloaded fixture bytes so SHA-256 checks survive every checkout.
test-games/sudoku-j2me/LICENSE -text
test-games/sudoku-j2me/*.jad -text
test-games/sudoku-j2me/*.jar -text
test-games/sudoku-j2me/*.zip -text

# Source release archives do not redistribute historical APKs or presentation art.
