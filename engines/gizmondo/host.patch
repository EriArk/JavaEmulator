+// Rebase each guest worker's elapsed time on pause and speed transitions.
+thread_local! {
+    static CLOCK: std::cell::Cell<(std::time::Instant, u128, u32)> =
+        std::cell::Cell::new((std::time::Instant::now(), 0, 100));
+}
+pub fn guest_micros() -> u64 {
+    CLOCK.with(|clock| {
+        let (since, micros, rate) = clock.get();
+        (micros + since.elapsed().as_micros() * u128::from(rate) / 100) as u64
+    })
+}
+pub fn guest_rate(rate: u32) {
+    CLOCK.with(|clock| {
+        let (since, micros, old) = clock.get();
+        if old != rate {
+            let now = std::time::Instant::now();
+            clock.set((now, micros + (now - since).as_micros() * u128::from(old) / 100, rate));
+        }
+    });
+}
