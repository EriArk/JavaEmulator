+// Each emulator worker owns its clock. Rebase it before a speed or pause change.
+thread_local! {
+    static GUEST_CLOCK: std::cell::Cell<(std::time::Instant, u128, u32)> =
+        std::cell::Cell::new((std::time::Instant::now(), 0, 100));
+}
+
+pub fn guest_millis() -> u64 {
+    GUEST_CLOCK.with(|clock| {
+        let (since, nanos, rate) = clock.get();
+        ((nanos + since.elapsed().as_nanos() * rate as u128 / 100) / 1_000_000) as u64
+    })
+}
+
+pub fn guest_rate(rate: u32) {
+    GUEST_CLOCK.with(|clock| {
+        let (since, acc, old) = clock.get();
+        let now = std::time::Instant::now();
+        clock.set((now, acc + (now - since).as_nanos() * old as u128 / 100, rate));
+    });
+}
