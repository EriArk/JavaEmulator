diff --git a/src/engine.c b/src/engine.c
index 971ec7a..8d52847 100644
--- a/src/engine.c
+++ b/src/engine.c
@@ -40,3 +40,12 @@
-    EM_JS(void, new_hook, (), {
-        self.main_call();
-    });
+    void new_hook(void) {
+        static double deadline;
+        double now = emscripten_get_now();
+        if (now < deadline) return;
+        int running = EM_ASM_INT({ return self.colorRunning === true; });
+        if (running) {
+            EM_ASM({ self.colorPump(); });
+            do { emscripten_sleep(1); }
+            while (EM_ASM_INT({ return self.colorPaused === true; }));
+        }
+        deadline = emscripten_get_now() + 8;
+    }
@@ -255,0 +265,3 @@ TRACE_DECL(bool engine_tick, (),
+    #ifdef __EMSCRIPTEN__
+    new_hook();
+    #endif
